# ./client/Dockerfile.staging
FROM node:20 as build

WORKDIR /app

# Variables d'environnement pour staging - définies explicitement
ENV NODE_ENV=staging
ENV REACT_APP_ENV=staging
ENV REACT_APP_API_URL=https://dev.beatboxgames.com
ENV GENERATE_SOURCEMAP=true
ENV REACT_APP_SENTRY_DSN=

# Copier les fichiers de dépendances
COPY package*.json ./

# Installer les dépendances
RUN npm install

# Copier le code source
COPY . .

# Afficher les variables d'environnement pour debug (optionnel)
RUN echo "Building with REACT_APP_API_URL=$REACT_APP_API_URL"
RUN echo "Building with REACT_APP_ENV=$REACT_APP_ENV"

# Build l'application avec les variables d'environnement
RUN npm run build

# Phase de production avec Nginx
FROM nginx:alpine

# Copier la configuration Nginx personnalisée pour staging
#COPY nginx.staging.conf /etc/nginx/conf.d/default.conf

# Copier les fichiers buildés
COPY --from=build /app/build /usr/share/nginx/html

# Ajouter un header pour identifier l'environnement
RUN echo 'add_header X-Environment "staging" always;' >> /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]